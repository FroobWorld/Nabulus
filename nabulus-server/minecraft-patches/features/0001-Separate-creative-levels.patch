                 if (inventory == null) {
                     return null;
                 }
@@ -53,7 +60,7 @@ public final class V4312 {
                     equipment.setMap(equipmentKey, item);
                 }
 
-                data.setMap("equipment", equipment);
+                data.setMap(equipmentDataKey, equipment); // Nabulus
 
